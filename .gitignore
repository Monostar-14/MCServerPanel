# ==============================================================================
#  MCServerPanel —— .gitignore
#  原则：仓库里只留「源码 / 文档 / 脚本 / 测试夹具」。
#        构建产物、IDE 缓存、运行期数据、本机配置、密钥一律不入库。
#  排查命令：
#    git status -uall                       # 还有哪些未忽略的文件
#    git ls-files -ci --exclude-standard    # 已入库但被忽略规则命中的文件（应为空）
#    git check-ignore -v <路径>             # 某路径为什么被忽略
# ==============================================================================

# ===== .NET 构建产物 =====
bin/
obj/
[Bb]in/
[Oo]bj/
artifacts/
publish/

# ===== 发布产物 =====
# 打包脚本（package.cmd / package.ps1 / package.sh）统一把产物写到 scripts/dist：
#   scripts/dist/win-x64/、scripts/dist/linux-x64/（未压缩）+ zip + tar.gz + SHA256SUMS.txt
# 这些都是构建产物，不进版本库；发版走 GitHub Release。
dist/
scripts/dist/
scripts/package.log

*.mcpanel.tmp
project.lock.json
project.fragment.lock.json

# 只在仓库根出现时才忽略的零散产物（不误伤将来的源码目录）
/*.dll
/*.exe
/*.pdb
/*.zip
/*.tar.gz
/*.nupkg

# ===== 运行期数据（--data-dir 指向仓库根时会落在这些位置） =====
/settings.json
/auth.json
/backups/
/logs/
*.log

# ===== 测试与覆盖率 =====
TestResults/
coverage/
coverage*.xml
coverage*.info
coverage*.json
*.trx
*.coverage
*.testlog

# ===== IDE / 编辑器 =====
.vs/
.vscode/
.idea/
.history/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
*.VC.db
*.VC.opendb
*.psess
*.vsp
*.vspx
*.vspscc
*.code-workspace

# ===== Python（scripts/ 下的辅助脚本） =====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ===== 本机环境与密钥（绝不能推） =====
.env
.env.*
*.pfx
*.p12
*.keystore

# ===== 系统垃圾 =====
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
.fuse_hidden*
.Trash-*
*~
*.swp
*.swo
~$*
